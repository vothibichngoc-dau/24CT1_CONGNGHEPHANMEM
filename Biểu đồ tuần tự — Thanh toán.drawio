        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle BIỂU ĐỒ TUẦN TỰ - ĐĂNG NHẬP\n\nactor \&quot;Khách hàng\&quot; as KH\nboundary \&quot;Giao diện FoodGo\&quot; as UI\ncontrol \&quot;Django Backend\&quot; as BE\ndatabase \&quot;PostgreSQL\&quot; as DB\n\nautonumber\n\nKH -&gt; UI: Chọn \&quot;Đăng nhập\&quot;\nUI --&gt; KH: Hiển thị form đăng nhập\nKH -&gt; UI: Nhập username và password\nUI -&gt; BE: Gửi thông tin đăng nhập\nBE -&gt; DB: Kiểm tra tài khoản\n\nalt Thông tin chính xác\n    DB --&gt; BE: Xác thực thành công\n    BE --&gt; UI: Đăng nhập thành công\n    UI --&gt; KH: Chuyển đến trang chủ\nelse Thông tin không chính xác\n    DB --&gt; BE: Xác thực thất bại\n    BE --&gt; UI: Thông báo lỗi\n    UI --&gt; KH: Yêu cầu đăng nhập lại\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="meZIoBjGl4eJACnkwTUs-456">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
