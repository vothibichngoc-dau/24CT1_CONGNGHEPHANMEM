        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle BIỂU ĐỒ TUẦN TỰ - THANH TOÁN\n\nactor \&quot;Khách hàng\&quot; as KH\nboundary \&quot;Giao diện FoodGo\&quot; as UI\ncontrol \&quot;Django Backend\&quot; as BE\ndatabase \&quot;PostgreSQL\&quot; as DB\n\nautonumber\n\nKH -&gt; UI: Chọn đơn hàng cần thanh toán\nUI -&gt; BE: Gửi yêu cầu thanh toán\nBE -&gt; DB: Kiểm tra thông tin đơn hàng\nDB --&gt; BE: Trả thông tin đơn hàng\n\nBE --&gt; UI: Hiển thị số tiền cần thanh toán\nUI --&gt; KH: Hiển thị thông tin thanh toán\n\nKH -&gt; UI: Chọn phương thức thanh toán\nUI -&gt; BE: Gửi phương thức thanh toán\n\nalt Thanh toán thành công\n    BE -&gt; DB: Cập nhật trạng thái thanh toán\n    DB --&gt; BE: Cập nhật thành công\n    BE -&gt; DB: Cập nhật trạng thái đơn hàng\n    DB --&gt; BE: Cập nhật thành công\n    BE --&gt; UI: Thanh toán thành công\n    UI --&gt; KH: Hiển thị kết quả thanh toán\nelse Thanh toán thất bại\n    BE --&gt; UI: Thanh toán thất bại\n    UI --&gt; KH: Hiển thị thông báo lỗi\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="meZIoBjGl4eJACnkwTUs-540">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
